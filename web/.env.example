# Backend API Endpoint
# In local development: http://localhost:5000/api
# In production: https://your-backend-api.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Site Canonical URL (SEO & Metadata)
# In local development: http://localhost:3000
# In production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: OAuth Web Client IDs
# Google OAuth Client ID for Web Sign-In
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# GitHub OAuth Client ID for Web Sign-In
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# Optional: Google Search Console Verification Token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
