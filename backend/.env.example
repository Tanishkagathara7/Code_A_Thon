# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# API Backend Port
PORT=5000

# GitHub OAuth Configuration (Backend Secret - DO NOT EXPOSE TO FRONTEND)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Email Provider Configuration (Choose one):
# Option A: Resend HTTPS API (Recommended for Render Free Tier - Port 443, never blocked)
# Get a free API key at https://resend.com (3,000 free emails/month)
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Option B: SendGrid HTTPS API (Alternative HTTPS over Port 443)
SENDGRID_API_KEY=
SENDGRID_FROM=

# Option C: Direct Gmail SMTP (Blocked by Render free tier, works on VPS/localhost)
SMTP_SERVICE=gmail
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="MindBloom" <your_email@gmail.com>

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key

# OpenRouter AI Gateway Configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

