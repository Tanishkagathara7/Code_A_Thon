{
  "expo": {
    "name": "MindBloom",
    "owner": "tvkms-team",
    "slug": "tanis",
    "scheme": [
      "mindbloom",
      "com.mindbloom.app",
      "com.googleusercontent.apps.878949461550-s6de153nvgoq1gb94191i1pgqfqbv1jd"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mindbloom.app"
    },
    "android": {
      "package": "com.mindbloom.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#0D111F",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "expo-font",
      "expo-video",
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "image": "./assets/code.png",
          "resizeMode": "contain",
          "backgroundColor": "#0D111F"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bc0e2321-ddf3-4df9-b813-e6e8c3549eeb"
      }
    }
  }
}
